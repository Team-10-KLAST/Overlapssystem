@* ============================================================
   LOGIN PAGE
   Handles the display and interaction for the login form.
   ============================================================ *@

@page "/"
@page "/login"
@attribute [AllowAnonymous]

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4 login-card">

        <h3 class="text-center mb-4">Log ind</h3>

        @* Error message *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        @* Email field *@
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" @bind="_loginDto.Email" placeholder="Email" />
        </div>

        @* Password field *@
        <div class="mb-3">
            <label class="form-label">Adgangskode</label>
            <input type="password" class="form-control" @bind="_loginDto.Password"
                   @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Adgangskode" />
        </div>

        @* Login button *@
        <button class="btn btn-primary w-100" @onclick="HandleLogin" disabled="@_isLoading">
            @(_isLoading ? "Logger ind..." : "Log ind")
        </button>
    </div>
</div>