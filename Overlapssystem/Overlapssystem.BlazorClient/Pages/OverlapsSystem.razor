@page "/overlapssystem/{ShiftId:int}"

<PageTitle>Overlapssystem</PageTitle>

<div class="overlap-page">
    <div class="overlap-top">
        <span>Vagtinfo: @shiftDate - @shiftType - @departmentName</span>
        <div class="overlap-top-actions">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a href="/activitylog" class="btn btn-outline-primary btn-sm">Aktivitetslog</a>
                </Authorized>
            </AuthorizeView>
            <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
                Log ud
            </button>
        </div>
    </div>

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger m-2">@_errorMessage</div>
    }

    <div class="overlap-middle">
        @if (schemas == null)
        {
            <p>Henter borgerskemaer...</p>
        }
        else if (!schemas.Any())
        {
            <p>Ingen borgerskemaer fundet.</p>
        }
        else
        {
            <div class="resident-grid">
                @foreach (var schema in schemas)
                {
                    <ResidentCard Schema="@schema" />
                }
            </div>
        }
    </div>

    <div class="overlap-bottom container-fluid">
        <div class="row">
            @* Left column — phone list *@
            <div class="col-md-4">
                <PhoneList ShiftId="@ShiftId" />
            </div>
            @* Center column — shift tasks *@
            <div class="col-md-4">
                <ShiftTaskSection DepartmentId="@currentDepartment" ShiftId="@ShiftId" />
            </div>
            @* Right column — note section *@
            <div class="col-md-4">
                <NoteSection DepartmentId="@currentDepartment" />
            </div>
        </div>
    </div>
</div>