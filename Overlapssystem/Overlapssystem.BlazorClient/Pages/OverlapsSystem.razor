@page "/overlapssystem/{ShiftId:int}"

<PageTitle>Overlapssystem</PageTitle>

<div class="overlap-page">

    @* TOP SECTION - Shift info placeholder *@
    <div class="overlap-top">
        <p>Vagtinfo: dato og vagttype kommer her</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">
            Log ud
        </button>
    </div>

    @* MIDDLE SECTION - Resident schema cards *@
    <div class="overlap-middle">
        @if (schemas == null)
        {
            <p>Henter borgerskemaer...</p>
        }
        else if (!schemas.Any())
        {
            <p>Ingen borgerskemaer fundet.</p>
        }
        else
        {
            <div class="resident-grid">
                @foreach (var schema in schemas)
                {
                    <ResidentCard Schema="@schema" />
                }
            </div>
        }
    </div>

    @* BOTTOM SECTION *@  
    <div class="overlap-bottom container-fluid mt-3">
        <div class="row">
            @* Venstre side (2/3 af pladsen) *@
            <div class="col-md-8">
                <div class="p-3 border rounded bg-light" style="min-height: 200px;">
                    <h5 class="fw-bold">Afdelingsopgaver</h5>
                    <p class="text-muted">Her kommer listen over opgaver...</p>
                    @* Til ny komponent med opgaver *@
                </div>
            </div>

            @* Højre side (1/3 af pladsen) *@
            <div class="col-md-4">
                <NoteSection DepartmentId="@currentDepartmentId" />
            </div>
        </div>
    </div>
</div>