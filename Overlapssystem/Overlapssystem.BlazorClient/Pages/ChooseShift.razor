@* ============================================================
   CHOOSE SHIFT PAGE
   Handles the display and interaction for choosing a shift.
   ============================================================ *@

@page "/choose-shift"
@using System.Globalization

<div class="choose-shift-page">
    <div class="choose-shift-card">
        <h3 class="choose-shift-title">Vælg vagt</h3>

		@* Date Picker *@
        <div class="shift-form-group">
            <label class="shift-form-label">Dato</label>
            <input type="date" class="shift-form-input" @bind="model.Date" @bind:format="yyyy-MM-dd" max="@MaxDate" />
        </div>

        @* Shift Type *@
        <div class="shift-form-group">
            <label class="shift-form-label">Vagt type</label>
            <select class="shift-form-input" @bind="model.ShiftType">
                <option value=0 disabled selected>Vælg vagt type</option>
                <option value="1">Dagvagt</option>
                <option value="2">Aftenvagt</option>
                <option value="3">Nattevagt</option>
            </select>
        </div>

        @* Department *@
        <div class="shift-form-group">
            <label class="shift-form-label">Afdeling</label>
            <select class="shift-form-input" @bind="model.DepartmentId">
                <option value="0" disabled selected>Vælg afdeling</option>
                <option value="1">Skoven</option>
                <option value="2">Slottet</option>
            </select>
        </div>
        
        @* Submit Button *@
        <button class="shift-submit-btn" @onclick="SaveShift">Start vagt</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="shift-error-message">@message</p>
        }
    </div>
</div>

