@* ============================================================
   CHOOSE SHIFT PAGE
   Handles the display and interaction for choosing a shift.
   ============================================================ *@

@page "/choose-shift"
@using System.Globalization
@inject HttpClient Http
@inject ISaveShiftService SaveShiftService
@inject NavigationManager Navigation

<style>
    .choose-shift-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f0f0f0;
    }

    .choose-shift-card {
        background: white;
        border-radius: 8px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .choose-shift-title {
        margin: 0 0 32px 0;
        font-size: 24px;
        color: #333;
        text-align: center;
    }

    .shift-form-group {
        margin-bottom: 20px;
    }

    .shift-form-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        font-size: 14px;
        color: #555;
    }

    .shift-form-input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
        background-color: #fafafa;
        box-sizing: border-box;
    }

        .shift-form-input:focus {
            outline: none;
            border-color: #5a9bd5;
            background-color: white;
        }

    .shift-submit-btn {
        width: 100%;
        padding: 12px;
        background-color: #5a9bd5;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
    }

        .shift-submit-btn:hover {
            background-color: #4a8bc5;
        }

    .shift-error-message {
        margin-top: 16px;
        color: #c0392b;
        font-size: 14px;
        text-align: center;
    }
</style>

<div class="choose-shift-page">
    <div class="choose-shift-card">
        <h3 class="choose-shift-title">Vælg vagt</h3>

        <div class="shift-form-group">
            <label class="shift-form-label">Dato</label>
            <input type="date" class="shift-form-input" @bind="model.Date" @bind:format="yyyy-MM-dd" max="@MaxDate" />
        </div>

        <div class="shift-form-group">
            <label class="shift-form-label">Vagt type</label>
            <select class="shift-form-input" @bind="model.ShiftType">
                <option value=0 disabled selected>Vælg vagt type</option>
                <option value="1">Dagvagt</option>
                <option value="2">Aftenvagt</option>
                <option value="3">Nattevagt</option>
            </select>
        </div>

        <div class="shift-form-group">
            <label class="shift-form-label">Afdeling</label>
            <select class="shift-form-input" @bind="model.DepartmentId">
                <option value="0" disabled selected>Vælg afdeling</option>
                <option value="1">Skoven</option>
                <option value="2">Slottet</option>
            </select>
        </div>

        <button class="shift-submit-btn" @onclick="SaveShift">Start vagt</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="shift-error-message">@message</p>
        }
    </div>
</div>

@code {
    private string MaxDate => DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private CreateShiftDto model = new()
    {
        Date = DateTime.Today
    };

    private string message = string.Empty;

    private async Task SaveShift()
    {
        var result = await SaveShiftService.SaveShiftAsync(model);

        if (result.IsSuccess)
            Navigation.NavigateTo($"/overlapssystem/{result.Data}");
        else
            message = result.Error!;
    }
}