@page "/choose-shift"
@using System.Globalization
@using Overlapssystem.Domain.Enums
@using Overlapssystem.Shared.DTOs
@using Overlapssystem.BlazorClient.Services
@inject HttpClient Http
@inject SaveShiftService SaveShiftService

<h3>Vælg vagt</h3>

<div>
    <label>Dato:</label>
    <input type="date" @bind="model.Date" @bind:format="yyyy-MM-dd" max="@MaxDate" />
</div>

<br />

<div>
    <label>Vagt type:</label>
    <select @bind="model.ShiftType">
        @foreach (var type in Enum.GetValues(typeof(ShiftType)))
        {
            <option value="@type">@type</option>
        }
    </select>
</div>

<br />

<div>
    <label>Afdeling:</label>
    <select @bind="model.Department">
        <option value="0" disabled selected>Vælg afdeling</option>
        @foreach (var dept in Enum.GetValues(typeof(DepartmentType)))
        {
            if ((DepartmentType)dept != DepartmentType.None)
            {
                <option value="@dept">@dept</option>
            }
        }
    </select>
</div>

<br />

<button @onclick="SaveShift">Gem</button>

<br />
<br />

<p>@message</p>

@code {
    private string MaxDate => DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private CreateShiftDto model = new()
    {
        Date = DateTime.Today
    };

    private string message = string.Empty;

    private async Task SaveShift()
    {
        message = await SaveShiftService.SaveShiftAsync(model);
    }
}