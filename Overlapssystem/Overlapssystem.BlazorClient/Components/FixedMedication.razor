@* ============================================================
   FIXED MEDICATION COMPONENT
   Displays the fixed medication times with a checkbox to mark as given.
   ============================================================ *@
@using Overlapssystem.Shared.DTOs


<span style="font-weight: bold; min-width: 70px; flex-shrink: 0; color: #333;">Medicin</span>

<div style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 8px;">
    @if (Schema.MedicationTimes.Any())
    {
        @foreach (var med in Schema.MedicationTimes)
        {
            <span class="section-value" style="display: flex; align-items: center; gap: 4px;">
                @med.PlannedTime
                <input type="checkbox"
                       checked="@med.IsGiven"
                       @onclick="() => HandleMedicationClicked(med)"
                       @onclick:preventDefault="true"
                       title="Markér som givet"
                       style="width: 11px; height: 11px; margin: 0; cursor: pointer; display: block;" />
            </span>
        }
    }
    else
    {
        <span class="section-value">—</span>
    }
</div>

<ConfirmDialog IsVisible="showConfirm"
               Message="@($"Er du sikker på at du vil markere medicin kl. {pendingMed?.PlannedTime} som givet for {Schema.Initials}?")"
               SubMessage="Denne handling kan ikke fortrydes."
               OnConfirm="ConfirmChange"
               OnCancel="CancelChange" />

@code {
	// The resident's schema is passed in from the parent component (ResidentCard).
    [Parameter] public ResidentSchemaDto Schema { get; set; } = default!;
    
    // Allows the parent (ResidentCard) to respond to the change
    [Parameter] public EventCallback<MedicationTimeDto> OnMedicationGiven { get; set; }

    private bool showConfirm = false;
    private MedicationTimeDto? pendingMed;

    // Shows the confirmation dialog when a checkbox is clicked.
    private void HandleMedicationClicked(MedicationTimeDto med)
    {
        if (med.IsGiven)
            return;

        pendingMed = med;
        showConfirm = true;
    }

    // If the user confirms, we invoke the callback to notify the parent.
    private async Task ConfirmChange()
    {
        await OnMedicationGiven.InvokeAsync(pendingMed);
        showConfirm = false;
        pendingMed = null;
    }

    // If the user cancels, we hide the dialog and clear the pending medication.
    private void CancelChange()
    {
        showConfirm = false;
        pendingMed = null;
    }
}