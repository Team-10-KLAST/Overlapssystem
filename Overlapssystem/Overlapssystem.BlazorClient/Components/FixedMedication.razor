@* ============================================================
   FIXED MEDICATION COMPONENT
   Displays the fixed medication times with a checkbox to mark as given.
   ============================================================ *@

<span class="medication-label">Medicin</span>
<div class="medication-times">
    @if (MedicationTimes.Any())
    {
        @foreach (var med in MedicationTimes)
        {
            <span class="section-value medication-time-entry">
                @med.PlannedTime
                <input type="checkbox"
                       checked="@med.IsGiven"
                       @onclick="() => HandleMedicationClicked(med)"
                       @onclick:preventDefault="true"
                       title="Markér som givet"
                       class="medication-checkbox" />
            </span>
        }
    }
    else
    {
        <span class="section-value">—</span>
    }
</div>

<ConfirmDialog IsVisible="showConfirm"
			   Message="@($"Er du sikker på at du vil markere medicin kl. {pendingMed?.PlannedTime} som givet for {Initials}?")"
			   SubMessage="Denne handling kan ikke fortrydes."
			   OnConfirm="ConfirmChange"
			   OnCancel="CancelChange" />
