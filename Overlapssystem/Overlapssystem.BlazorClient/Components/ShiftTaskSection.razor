@* ============================================================
   SHIFT TASK SECTION COMPONENT
   Displays and manages department task assignments for the shift.
   ============================================================ *@

@inject IDepartmentTaskDataService TaskService

<div class="task-panel">

    @* Panel header *@
    <div class="task-panel-header">
        <span class="task-panel-title">Ansvarsopgaver</span>
    </div>

    @* Error message *@
    @if (_errorMessage != null)
    {
        <div class="alert alert-danger m-1" style="font-size: 12px;">@_errorMessage</div>
    }

    @* Scrollable task rows — column headers are sticky inside so widths always match *@
    <div class="task-list-body">

        @* Column headers — sticky so they stay visible when scrolling *@
        <div class="task-col-headers">
            <span>Opgaver</span>
            <span>Medarbejder</span>
            <span></span>
        </div>

        @if (tasks == null)
        {
            <p class="p-2 m-0" style="font-size: 13px;">Henter opgaver...</p>
        }
        else
        {
            @foreach (var task in tasks)
            {
                <div class="task-row">
                    @* Task name — fixed 130px width *@
                    <input class="task-name-input"
                           placeholder="Opgavenavn..."
                           @bind="task.TaskName"
                           @bind:event="onchange"
                           @bind:after="() => UpdateTaskName(task)" />

                    @* Assigned employee input *@
                    <input class="task-employee-input"
                           placeholder="Navn/initialer..."
                           @bind="task.AssignedEmployee"
                           @bind:event="onchange"
                           @bind:after="() => SaveAssignment(task)" />

                    @* Delete task button *@
                    <button class="task-delete-btn" @onclick="() => DeleteTask(task)">✕</button>
                </div>
            }
        }
    </div>

    @* Add task button — full width, dark gray *@
    <div class="task-add-wrapper">
        <button class="task-add-btn" @onclick="AddTask">+ Tilføj opgave</button>
    </div>
</div>

@code {
    [Parameter] public int DepartmentId { get; set; }
    [Parameter] public int ShiftId { get; set; }

    private List<DepartmentTaskDto>? tasks;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (DepartmentId > 0 && ShiftId > 0)
        {
            var result = await TaskService.GetTasksAsync(DepartmentId, ShiftId);
            if (result.IsSuccess)
                tasks = result.Data!.ToList();
            else
                _errorMessage = result.Error;
        }
    }

    private async Task UpdateTaskName(DepartmentTaskDto task)
    {
        var result = await TaskService.UpdateTaskNameAsync(task);
        if (!result.IsSuccess)
            _errorMessage = result.Error;
    }

    private async Task SaveAssignment(DepartmentTaskDto task)
    {
        var result = await TaskService.SaveAssignmentAsync(ShiftId, task);
        if (!result.IsSuccess)
            _errorMessage = result.Error;
    }

    private async Task AddTask()
    {
        var result = await TaskService.CreateTaskAsync(DepartmentId);
        if (result.IsSuccess)
            tasks?.Add(result.Data!);
        else
            _errorMessage = result.Error;
    }

    private async Task DeleteTask(DepartmentTaskDto task)
    {
        var result = await TaskService.DeleteTaskAsync(task.Id);
        if (result.IsSuccess)
            tasks?.Remove(task);
        else
            _errorMessage = result.Error;
    }
}
