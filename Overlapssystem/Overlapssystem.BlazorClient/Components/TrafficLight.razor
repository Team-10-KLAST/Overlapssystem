@* ============================================================
   TRAFFIC LIGHT COMPONENT
   Handles the display and interaction for the traffic light risk assessment.
   ============================================================ *@

<div class="traffic-light-interactive">
    <span class="light green @(CurrentColor == "Green" ? "active" : "")" 
          @onclick='() => HandleClick("Green")'></span>
    <span class="light yellow @(CurrentColor == "Yellow" ? "active" : "")" 
          @onclick='() => HandleClick("Yellow")'></span>
    <span class="light red @(CurrentColor == "Red" ? "active" : "")" 
          @onclick='() => HandleClick("Red")'></span>
</div>

<ConfirmDialog IsVisible="showConfirm"
               Message="@($"Er du sikker på at du vil ændre risikovurderingen for {Initials}?")"
               SubMessage="@($"{TranslateColor(CurrentColor)} → {TranslateColor(pendingColor)}")"
               OnConfirm="ConfirmChange"
               OnCancel="CancelChange" />
