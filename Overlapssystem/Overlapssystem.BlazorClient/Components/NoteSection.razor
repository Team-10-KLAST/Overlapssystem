
@inject IDepartmentNoteDataService NoteService

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">Huskeseddel</div>
    <div class="card-body p-0">
        <textarea class="form-control border-0"
                  style="height: 200px; background-color: #fffde7; resize: none;"
                  @bind="Content"
                  @bind:event="oninput"
                  @onchange="SaveInternal"
                  placeholder="Skriv din note her...">
        </textarea>
    </div>
    @if (isSaving)
    {
        <div class="card-footer py-1">
            <small class="text-muted italic">Gemmer ændringer...</small>
        </div>
    }
</div>

@code {
    [Parameter] public int DepartmentId { get; set; }

    private string? Content { get; set; }
    private bool isSaving = false;

    protected override async Task OnParametersSetAsync()
    {
        if (DepartmentId > 0)
        {
            var notes = await NoteService.GetNoteByDepartmentIdAsync(DepartmentId);
            Content = notes.FirstOrDefault()?.Content ?? string.Empty;
        }
    }

    private async Task SaveInternal()
    {
        isSaving = true;
        await NoteService.UpdateNoteAsync(new DepartmentNoteDto { DepartmentId = DepartmentId, Content = Content ?? "" });
        await Task.Delay(500);
        isSaving = false;
    }
}