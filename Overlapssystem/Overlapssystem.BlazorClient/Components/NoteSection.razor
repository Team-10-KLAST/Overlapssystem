@* ============================================================
   NOTE SECTION COMPONENT
   Sticky note for department-wide notes that persist across shifts.
   ============================================================ *@

@inject IDepartmentNoteDataService NoteService

<div class="note-panel">

    @* Panel header — yellow background, bold black title *@
    <div class="note-panel-header">
        <span class="note-panel-title">Huskeseddel</span>
    </div>

    @* Error message *@
    @if (_errorMessage != null)
    {
        <div class="alert alert-danger m-1" style="font-size: 12px;">@_errorMessage</div>
    }

    @* Note content area *@
    <div class="note-body">
        <textarea class="note-textarea"
                  @bind="Content"
                  @bind:event="oninput"
                  @bind:after="SaveInternal"
                  placeholder="Skriv din note her...">
        </textarea>

        @* Saving indicator *@
        <div class="note-saving-indicator">
            @if (isSaving)
            {
                <small style="color: #6c757d; font-style: italic;">Gemmer ændringer...</small>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int DepartmentId { get; set; }
    private string Content = string.Empty;
    private bool isSaving = false;
    private int _loadedDepartmentId = 0;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (DepartmentId > 0 && DepartmentId != _loadedDepartmentId)
        {
            _loadedDepartmentId = DepartmentId;
            var result = await NoteService.GetNoteByDepartmentIdAsync(DepartmentId);
            if (result.IsSuccess)
                Content = result.Data!.FirstOrDefault()?.Content ?? string.Empty;
            else
                _errorMessage = result.Error;
        }
    }

    private async Task SaveInternal()
    {
        isSaving = true;
        var result = await NoteService.UpdateNoteAsync(new DepartmentNoteDto
        {
            DepartmentId = DepartmentId,
            Content = Content ?? ""
        });

        if (!result.IsSuccess)
            _errorMessage = result.Error;

        await Task.Delay(500);
        isSaving = false;
        StateHasChanged();
    }
}
