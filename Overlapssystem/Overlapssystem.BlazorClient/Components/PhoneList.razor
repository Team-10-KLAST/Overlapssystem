@* ============================================================
   PHONE LIST COMPONENT
   Displays all phones with employee assignment and round test checkbox.
   ============================================================ *@

@using Overlapssystem.Shared.DTOs
@using Overlapssystem.BlazorClient.Services
@inject IPhoneDataService PhoneService
@inject IEmployeeDataService EmployeeService

<div class="phone-panel">

    @* Panel header with title and reset button *@
    <div class="phone-panel-header">
        <span class="phone-panel-title">Telefonliste</span>
        @if (phones != null && phones.Any())
        {
            <button class="phone-reset-btn" @onclick="ResetAllPhones">Nulstil alle</button>
        }
    </div>

    @* Error message *@
    @if (_errorMessage != null)
    {
        <div class="alert alert-danger m-1" style="font-size: 12px;">@_errorMessage</div>
    }

    @* Column headers *@
    <div class="phone-col-headers">
        <span>Telefon</span>
        <span>Medarbejder</span>
        <span>Test</span>
    </div>

    @* Scrollable phone rows *@
    <div class="phone-list-body">
        @if (phones == null)
        {
            <p class="p-2 m-0" style="font-size: 13px;">Henter telefoner...</p>
        }
        else if (!phones.Any())
        {
            <p class="p-2 m-0" style="font-size: 13px; color: #6b7280;">Ingen telefoner fundet.</p>
        }
        else
        {
            @foreach (var phone in phones)
            {
                <div class="phone-row">
                    @* Phone number *@
                    <span class="phone-number">@phone.Number</span>

                    @* Employee dropdown styled as plain input *@
                    <select class="phone-employee-select @(phone.EmployeeId == null ? "empty" : "")"
                            value="@(phone.EmployeeId?.ToString() ?? "")"
                            @onchange="@(e => OnEmployeeChanged(e, phone))">
                        <option value="">Tilføj initialer</option>
                        @foreach (var emp in AllEmployees)
                        {
                          var takenByOther = phones!.Any(p => p.Id != phone.Id && p.EmployeeId == emp.EmployeeId);
                          <option value="@emp.EmployeeId" disabled="@takenByOther">
                            @(takenByOther ? $"✓ {emp.Initials}" : emp.Initials)
                          </option>
                        }
                    </select>

                    @* Round test checkbox *@
                    <input type="checkbox"
                           class="phone-checkbox"
                           disabled="@(phone.EmployeeId == null)"
                           checked="@phone.IsTested"
                           @onchange="@(e => OnTestChanged(e, phone))" />
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int ShiftId { get; set; }
    [Parameter] public List<EmployeeDto> AllEmployees { get; set; } = new();

    private List<PhoneDto>? phones;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (ShiftId > 0)
        {
            var errors = new List<string>();

            var phonesResult = await PhoneService.GetPhonesAsync();
            if (phonesResult.IsSuccess)
                phones = phonesResult.Data!.OrderBy(p => p.Number).ToList();
            else
                errors.Add(phonesResult.Error!);

            var employeesResult = await EmployeeService.GetEmployeesAsync();
            if (employeesResult.IsSuccess)
                AllEmployees = employeesResult.Data!.ToList();
            else
                errors.Add(employeesResult.Error!);

            _errorMessage = errors.Any() ? string.Join(" | ", errors) : null;
        }
    }

    private async Task OnEmployeeChanged(ChangeEventArgs e, PhoneDto phone)
    {
        var previousEmployeeId = phone.EmployeeId;

        if (int.TryParse(e.Value?.ToString(), out var employeeId))
            phone.EmployeeId = employeeId;
        else
        {
            phone.EmployeeId = null;
            phone.IsTested = false;
        }

        StateHasChanged();

        var result = await PhoneService.UpdatePhoneAsync(phone);
        if (!result.IsSuccess)
        {
            phone.EmployeeId = previousEmployeeId;
            _errorMessage = result.Error;
            StateHasChanged();
        }
    }

    private async Task OnTestChanged(ChangeEventArgs e, PhoneDto phone)
    {
        if (phone.EmployeeId == null) return;

        if (e.Value is bool isTested)
        {
            phone.IsTested = isTested;
            var result = await PhoneService.UpdatePhoneAsync(phone);
            if (!result.IsSuccess)
            {
                phone.IsTested = !isTested;
                _errorMessage = result.Error;
            }
        }
    }

    private async Task ResetAllPhones()
    {
        if (phones == null || !phones.Any()) return;

        foreach (var phone in phones)
        {
            if (phone.EmployeeId != null || phone.IsTested)
            {
                phone.EmployeeId = null;
                phone.IsTested = false;
                await PhoneService.UpdatePhoneAsync(phone);
            }
        }

        StateHasChanged();
    }
}
