@* ============================================================
   PN MEDICATION COMPONENT
   Clickable field — shows a time input on click, closes on change or Enter/Escape.
   Multiple PN times are supported. Each entry shows a ✕ delete button.
   Delete requires confirmation via ConfirmDialog.
   ============================================================ *@

<span style="font-weight: bold; min-width: 70px; flex-shrink: 0; color: #333;">PN</span>

<span class="section-value">
    @if (ExistingPNTimes.Count == 0 && !IsAddingNew)
    {
        <span class="pn-time" @onclick="StartAddNew">—</span>
    }
    else
    {
        @* Loop over existing registrations — click a time to edit, click ✕ to delete *@
        @for (int i = 0; i < ExistingPNTimes.Count; i++)
        {
            var index = i;
            var pn = ExistingPNTimes[index];
            @if (EditingIndex == index)
            {
                <input class="pn-input"
                       type="time"
                       value="@pn.GivenTime"
                       @onchange="e => OnEditTimeChanged(e, index)"
                       @onkeydown="OnKeyDown" />
            }
            else
            {
                <span class="pn-entry"><span class="pn-time" @onclick="() => StartEdit(index)">@FormatTime(pn.GivenTime)</span><span class="pn-delete" @onclick="() => StartDelete(pn)" title="Slet">✕</span></span>
            }
        }

        @* New time input or + button *@
        @if (IsAddingNew)
        {
            <input class="pn-input"
                   type="time"
                   value=""
                   @oninput="e => pendingTime = e.Value?.ToString() ?? string.Empty"
                   @onchange="OnNewTimeChanged"
                   @onkeydown="OnKeyDownNew" />
        }
        else
        {
            <span class="pn-add" @onclick="StartAddNew">+</span>
        }
    }
</span>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Message="Er du sikker?"
               SubMessage="Slet denne PN-tid permanent?"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

