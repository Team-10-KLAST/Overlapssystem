@* ============================================================
   PN MEDICATION COMPONENT
   Clickable field — shows a time input on click, closes on change or Enter/Escape.
   Multiple PN times are supported. Each entry shows a ✕ delete button.
   Delete requires confirmation via ConfirmDialog.
   ============================================================ *@
@using Overlapssystem.Shared.DTOs

@* PN label *@
<span style="font-weight: bold; min-width: 70px; flex-shrink: 0; color: #333;">PN</span>

@* List of registered PN times with add and delete support *@
<span class="section-value">
    @* Empty state — dash shown when no times are registered *@
    @if (ExistingPNTimes.Count == 0 && !IsAddingNew)
    {
        <span class="pn-time" @onclick="StartAddNew">—</span>
    }
    else
    {
        @* Loop over existing registrations — click a time to edit, click ✕ to delete *@
        @for (int i = 0; i < ExistingPNTimes.Count; i++)
        {
            var index = i;
            var pn = ExistingPNTimes[index];
            @if (EditingIndex == index)
            {
                @* Time input shown when editing an existing entry *@
                <input class="pn-input"
                       type="time"
                       value="@pn.GivenTime"
                       @onchange="e => OnEditTimeChanged(e, index)"
                       @onkeydown="OnKeyDown" />
            }
            else
            {
                @* Time label and delete button for this entry *@
                <span class="pn-entry"><span class="pn-time" @onclick="() => StartEdit(index)">@FormatTime(pn.GivenTime)</span><span class="pn-delete" @onclick="() => StartDelete(pn)" title="Slet">✕</span></span>
            }
        }

        @* New time input or + button *@
        @if (IsAddingNew)
        {
            @* Time input for registering a new PN time *@
            <input class="pn-input"
                   type="time"
                   value=""
                   @oninput="e => pendingTime = e.Value?.ToString() ?? string.Empty"
                   @onchange="OnNewTimeChanged"
                   @onkeydown="OnKeyDownNew" />
        }
        else
        {
            @* Button to add a new PN time *@
            <span class="pn-add" @onclick="StartAddNew">+</span>
        }
    }
</span>

@* Delete confirmation — uses the shared ConfirmDialog component *@
<ConfirmDialog IsVisible="showDeleteConfirm"
               Message="Er du sikker?"
               SubMessage="Slet denne PN-tid permanent?"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    // The schema data passed in from ResidentCard.
    [Parameter]
    public ResidentSchemaDto Schema { get; set; } = default!;

    // All registered PN times for this schema, loaded and passed in by ResidentCard.
    [Parameter]
    public List<PNDto> ExistingPNTimes { get; set; } = new();

    // Raised when the user adds a new PN time — ResidentCard calls the API.
    [Parameter]
    public EventCallback<PNDto> OnPNAdded { get; set; }

    // Raised when the user deletes a PN time — ResidentCard calls the API.
    [Parameter]
    public EventCallback<PNDto> OnPNDeleted { get; set; }

    // Index of the time currently being edited, or -1 if none.
    private int EditingIndex { get; set; } = -1;

    // True when the new-time input field is visible.
    private bool IsAddingNew { get; set; } = false;

    // PN registration awaiting delete confirmation.
    private PNDto? pendingDelete = null;

    // True when the delete confirm dialog is visible.
    private bool showDeleteConfirm = false;

    // Tracks the time value as the user types, used to save on Enter.
    private string pendingTime = string.Empty;

    // Opens the inline edit input for the time at the given index.
    private void StartEdit(int index)
    {
        EditingIndex = index;
        IsAddingNew = false;
    }

    // Shows the new-time input field and clears any previously tracked time.
    private void StartAddNew()
    {
        IsAddingNew = true;
        EditingIndex = -1;
        pendingTime = string.Empty;
    }

    // Opens the delete confirmation dialog for the given PN.
    private void StartDelete(PNDto pn)
    {
        pendingDelete = pn;
        showDeleteConfirm = true;
    }

    // Notifies ResidentCard to delete the PN via the API, then closes the dialog.
    private async Task ConfirmDelete()
    {
        if (pendingDelete == null)
            return;

        await OnPNDeleted.InvokeAsync(pendingDelete);
        showDeleteConfirm = false;
        pendingDelete = null;
    }

    // Cancels the delete without deleting.
    private void CancelDelete()
    {
        showDeleteConfirm = false;
        pendingDelete = null;
    }

    // Formats a time string to HH:mm for compact display.
    private string FormatTime(string time)
    {
        if (time.Length >= 5)
            return time.Substring(0, 5);
        return time;
    }

    // Handles time change when editing an existing entry — updates the local display only.
    private void OnEditTimeChanged(ChangeEventArgs e, int index)
    {
        var time = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(time))
            ExistingPNTimes[index].GivenTime = time;
        EditingIndex = -1;
    }

    // Handles time input when the user leaves the field — skipped if Enter already saved the entry.
    private async Task OnNewTimeChanged(ChangeEventArgs e)
    {
        if (!IsAddingNew)
            return;

        var time = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(time))
        {
            var dto = new PNDto { ResidentSchemaId = Schema.ResidentSchemaId, GivenTime = time };
            await OnPNAdded.InvokeAsync(dto);
        }
        IsAddingNew = false;
        pendingTime = string.Empty;
    }

    // Closes the edit input on Enter or Escape.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Escape")
        {
            EditingIndex = -1;
            IsAddingNew = false;
        }
    }

    // Saves pendingTime on Enter, or discards on Escape. onchange handles blur without Enter.
    private async Task OnKeyDownNew(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!string.IsNullOrEmpty(pendingTime))
            {
                var dto = new PNDto { ResidentSchemaId = Schema.ResidentSchemaId, GivenTime = pendingTime };
                await OnPNAdded.InvokeAsync(dto);
            }
            IsAddingNew = false;
            pendingTime = string.Empty;
        }
        else if (e.Key == "Escape")
        {
            IsAddingNew = false;
            pendingTime = string.Empty;
        }
    }
}
