@* ============================================================
   EMPLOYEE ASSIGNMENT COMPONENT
   Reusable component for assigning one or two employees to a resident.
   ============================================================ *@

<div class="employee-section">
    <span class="section-label">Medarbejder</span>

    <div class="employee-controls">
        @* Dropdown 1: Primary employee *@
        <select class="employee-select" 
                value="@SelectedPrimaryId" 
                @onchange="@(e => OnEmployeeSelected(e, 1))">
            <option value="">tilføj</option>
            @foreach (var emp in GetAvailableEmployees(1))
            {
                        <option value="@emp.EmployeeId">@emp.Initials</option>
            }
        </select>

        @* Dropdown 2: Secondary employee *@
        <select class="employee-select" 
                value="@SelectedSecondaryId" 
                @onchange="@(e => OnEmployeeSelected(e, 2))">
            <option value="">tilføj</option>
            @foreach (var emp in GetAvailableEmployees(2))
            {
                        <option value="@emp.EmployeeId">@emp.Initials</option>
            }
        </select>
    </div>
</div>
