@* ============================================================
   RESIDENT CARD COMPONENT
   Displays one resident's schema as a card on the overlap page.
   Layout matches the existing Excel-based system.
   Sections marked as "placeholder" will be replaced by other features.
   ============================================================ *@

@inject ITrafficLightDataService TrafficLightService
@inject IResidentStatusDataService StatusService
@inject IMedicationDataService MedicationService
@inject IEmployeeDataService EmployeeDataService
@inject IPNDataService PNDataService
@inject IRelativeContactDataService RelativeContactService
@inject IEmployeeAssignmentDataService AssignmentService


<div class="resident-card">

    @* Error message shown if any API call in OnInitializedAsync fails *@
    @if (loadError)
    {
        <div class="card-error">
            Noget kunne ikke indlæses. Prøv at genindlæse siden.
        </div>
    }

    @* HEADER  *@
    <div class="card-header">
        <span class="initials">@Schema.Initials</span>
    </div>

    @if (_errorMessage != null)
    {
        <div class="card-error">@_errorMessage</div>
    }

    @* RISK ASSESSMENT  *@
    <div class="card-section risk-section">
        <span class="section-label">Risiko</span>
        <div class="traffic-light-placeholder">
            <TrafficLight CurrentColor="@Schema.TrafficLight"
                          OnColorChanged="HandleTrafficLightChanged"
                          Initials="@Schema.Initials" />
        </div>
    </div>

    @* FIXED MEDICATION *@
    <div class="card-section">
        <FixedMedication MedicationTimes="@Schema.MedicationTimes"
                         Initials="@Schema.Initials"
                         OnMedicationGiven="HandleMedicationGiven" />
    </div>

    @* PN MEDICATION *@
    <div class="card-section">
        <PNMedication Schema="@Schema"
                      ExistingPNTimes="@pnTimes"
                      OnPNAdded="HandlePNAdded"
                      OnPNDeleted="HandlePNDeleted" />
    </div>

    @* SHOPPING DAY *@
    <div class="card-section">
        <span class="section-label">Handledag</span>
        <span class="section-value">@Schema.ShoppingDay</span>
    </div>

    @* PAYMENT METHOD *@
    <div class="card-section">
        <span class="section-label">Betaling</span>
        <span class="section-value">@Schema.PaymentMethod</span>
    </div>

    @* RELATIVE CONTACT *@
    <div class="card-section">
        <RelativeContact Schema="@Schema"
                         ExistingContact="@relativeContact"
                         OnContactSaved="HandleContactSaved" />
    </div>

    @* EMPLOYEE ASSIGNMENT *@
    <EmployeeAssignment ResidentSchemaId="@Schema.ResidentSchemaId" 
                     AllEmployees="@allEmployees"
                     SelectedPrimaryId="@Schema.SelectedPrimaryId"
                     SelectedSecondaryId="@Schema.SelectedSecondaryId" 
                     OnEmployeeChanged="HandleEmployeeChanged" />

    @* STATUS - Editable status field with save and confirm dialog. *@
    <div class="card-section status-section">
        <span class="section-label">Status</span>
        <StatusField Status="@Schema.Status"
                     ResidentSchemaId="@Schema.ResidentSchemaId"
                     Initials="@Schema.Initials"
                     OnStatusSaved="HandleStatusSaved" />
    </div>

</div>



@code {
    // The schema data passed in from the parent page.
    // [Parameter] means the parent provides this value:
    // <ResidentCard Schema="@schema" />
    [Parameter]
    public ResidentSchemaDto Schema { get; set; } = default!;
    private List<EmployeeDto> allEmployees = new();

    // True if any API call in OnInitializedAsync failed — triggers the error message in the card.
    private bool loadError = false;

    // A general error message string that can be set by any operation in the card to show an error to the user.
    private string? _errorMessage;

    // All PN registrations for this schema, owned by ResidentCard and passed to PNMedication.
    private List<PNDto> pnTimes = new();

    // The existing relative contact for this schema, owned by ResidentCard and passed to RelativeContact.
    private RelativeContactDto? relativeContact = null;

    // Loads employees, PN times, and the relative contact in parallel when the card initializes.
    protected override async Task OnInitializedAsync()
    {
        var employeesTask = EmployeeDataService.GetEmployeesAsync();
        var pnsTask = PNDataService.GetPNsBySchemaAsync(Schema.ResidentSchemaId);
        var contactsTask = RelativeContactService.GetBySchemaAsync(Schema.ResidentSchemaId);

        var employeesResult = await employeesTask;
        if (employeesResult.IsSuccess)
            allEmployees = employeesResult.Data!.ToList();
        else
            loadError = true;

        var pnsResult = await pnsTask;
        if (pnsResult.IsSuccess)
            pnTimes = pnsResult.Data!.ToList();
        else
            loadError = true;

        var contactsResult = await contactsTask;
        if (contactsResult.IsSuccess)
            relativeContact = contactsResult.Data!.FirstOrDefault();
        else
            loadError = true;
    }

    // Persists the new traffic light color via the API and updates the local schema on success.
    // ResidentCard owns this because it holds the schema and is responsible for all data mutations.
    private async Task HandleTrafficLightChanged(string newColor)
    {
        var result = await TrafficLightService.UpdateTrafficLightAsync(Schema.ResidentSchemaId, newColor);

        if (result.IsSuccess)
            Schema.TrafficLight = newColor;

        else
            _errorMessage = result.Error;
    }

    // Persists the new status text via the API and updates the local schema on success.
    // ResidentCard owns this because it holds the schema and is responsible for all data mutations.
    private async Task HandleStatusSaved(string newStatus)
    {
        var result = await StatusService.UpdateStatusAsync(Schema.ResidentSchemaId, newStatus);

        if (result.IsSuccess)
            Schema.Status = newStatus;
        else
            _errorMessage = result.Error;
    }

    // Persists the medication as given via the API and updates the local state on success.
    // ResidentCard owns this because it holds the schema and is responsible for all data mutations.
    private async Task HandleMedicationGiven(MedicationTimeDto med)
    {
        var result = await MedicationService.MarkAsGivenAsync(Schema.ResidentSchemaId, med.MedicationTimeId);

        if (result.IsSuccess)
            med.IsGiven = true;
        else
            _errorMessage = result.Error;
    }

    // Registers a new PN time via the API and adds the saved entry to the local list.
    private async Task HandlePNAdded(PNDto dto)
    {
        var result = await PNDataService.RegisterPNAsync(dto);

        if (result.IsSuccess)
            pnTimes.Add(result.Data!);
        else
            _errorMessage = result.Error;
    }

    // Deletes a PN time via the API and removes it from the local list.
    private async Task HandlePNDeleted(PNDto dto)
    {
        var result = await PNDataService.DeletePNAsync(dto.PNId);

        if (result.IsSuccess)
            pnTimes.Remove(dto);
        else
            _errorMessage = result.Error;
    }

    // Saves the relative contact note via the API — creates a new record or updates the existing one.
    private async Task HandleContactSaved(RelativeContactDto dto)
    {
        if (relativeContact == null)
        {
            var result = await RelativeContactService.CreateAsync(dto);

            if (result.IsSuccess)
                relativeContact = result.Data;
            else
                _errorMessage = result.Error;
        }
        else
        {
            var result = await RelativeContactService.UpdateAsync(dto);

            if (result.IsSuccess)
                relativeContact = dto;
            else
                _errorMessage = result.Error;
        }
    }

	// Assigns the selected employee via the API and updates the local schema on success.
    private async Task HandleEmployeeChanged((int position, int? employeeId) args)
    {
        if (args.employeeId.HasValue)
        {
            var success = await AssignmentService.AssignEmployeeAsync(
                Schema.ResidentSchemaId, args.employeeId.Value, args.position);

            if (success)
            {
                if (args.position == 1) Schema.SelectedPrimaryId = args.employeeId;
                else Schema.SelectedSecondaryId = args.employeeId;
            }
        }
        else
        {
            if (args.position == 1) Schema.SelectedPrimaryId = null;
            else Schema.SelectedSecondaryId = null;
        }
    }
}