@* ============================================================
   RESIDENT CARD COMPONENT
   Displays one resident's schema as a card on the overlap page.
   Layout matches the existing Excel-based system.
   Sections marked as "placeholder" will be replaced by other features.
   ============================================================ *@

@inject ITrafficLightDataService TrafficLightService

<div class="resident-card">

    @* HEADER  *@
    <div class="card-header">
        <span class="initials">@Schema.Initials</span>
    </div>

    @* RISK ASSESSMENT  *@
    <div class="card-section risk-section">
        <span class="section-label">Risiko</span>
        <div class="traffic-light-placeholder">
            <TrafficLight CurrentColor="@Schema.TrafficLight" OnColorChanged="HandleTrafficLightChanged" />
        </div>
    </div>

    @* MEDICATION  *@
    <div class="card-section">
        <span class="section-label">Medicin</span>
        <span class="section-value">@Schema.MedicinTime</span>
    </div>

    @* PN MEDICATION  *@
    <div class="card-section">
        <span class="section-label">PN-tid</span>
        <span class="section-value placeholder-text">—</span>
    </div>

    @* SHOPPING DAY *@
    <div class="card-section">
        <span class="section-label">Handledag</span>
        <span class="section-value">@Schema.ShoppingDay</span>
    </div>

    @* PAYMENT METHOD *@
    <div class="card-section">
        <span class="section-label">Betaling</span>
        <span class="section-value">@Schema.PaymentMethod</span>
    </div>

    @* RELATIVE CONTACT *@
    <div class="card-section">
        <span class="section-label">Pårørende</span>
        <span class="section-value">@Schema.RelativeContact</span>
    </div>

    @* STATUS - (placeholder - will become editable). *@
    <div class="card-section status-section">
        <span class="section-label">Status</span>
        <span class="section-value">@Schema.Status</span>
    </div>

</div>



@code {
    // The schema data passed in from the parent page.
    // [Parameter] means the parent provides this value:
    // <ResidentCard Schema="@schema" />
    [Parameter]
    public ResidentSchemaDto Schema { get; set; } = default!;

	// When the traffic light changes, we update the local schema and call the service to persist it.
    private async Task HandleTrafficLightChanged(string newColor)
    {
        try
        {
            await TrafficLightService.UpdateTrafficLightAsync(Schema.ResidentSchemaId, newColor);
            Schema.TrafficLight = newColor; // opdater kun lokalt hvis API-kaldet lykkedes
        }
        catch (Exception)
        {
            // TODO: Tilføj fejlhåndtering til brugeren på et senere tidspunkt
        }
    }
}