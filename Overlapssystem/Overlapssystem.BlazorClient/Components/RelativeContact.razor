@* ============================================================
   RELATIVE CONTACT COMPONENT
   Single textarea for writing a pårørende contact message
   to inform the next shift. Supports save and cancel.
   ============================================================ *@

@* Label — matches section-label style used across the card *@
<span style="font-weight: bold; min-width: 70px; flex-shrink: 0; color: #333;">Pårørende</span>

@* Content area — grows to fill remaining width of card section *@
<div class="rc-content">

    @if (hasSavedMessage && !isEditing)
    {
        @* Saved state: renders newlines as <br> so line breaks entered by the user are preserved *@
        <div class="rc-saved-text" title="@currentMessage" @onclick="StartEditing">
            @SavedMessageHtml
        </div>
    }
    else
    {
        @* Empty or editing state: textarea with transparent border until focused *@
        <textarea class="rc-textarea"
                  @bind="currentMessage"
                  @bind:event="oninput"
                  @onfocus="OnFocus"
                  @onblur="OnBlur"
                  placeholder="Beskriv pårørendekontakt til næste vagt..." />

        @* Gem and Annuller — only visible when the user has typed a change *@
        @if (isEditing && HasChanges)
        {
            <div class="rc-actions">
                <button class="rc-btn-save" @onclick="SaveMessage">Gem</button>
                <button class="rc-btn-cancel" @onclick="Cancel">Annuller</button>
            </div>
        }
    }

</div>

@code {
    [Parameter]
    public string ContactNote { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnContactSaved { get; set; }

    private string currentMessage = string.Empty;
    private string savedMessage = string.Empty;
    private bool isEditing = false;
    private bool hasSavedMessage = false;
    private bool HasChanges => currentMessage != savedMessage;

    private MarkupString SavedMessageHtml =>
        new(System.Net.WebUtility.HtmlEncode(currentMessage).Replace("\n", "<br>"));

    protected override void OnParametersSet()
    {
        if (!isEditing)
        {
            savedMessage = ContactNote;
            currentMessage = savedMessage;
            hasSavedMessage = !string.IsNullOrWhiteSpace(savedMessage);
        }
    }

    private void OnFocus() => isEditing = true;

    private void OnBlur()
    {
        if (!HasChanges)
            isEditing = false;
    }

    private void StartEditing() => isEditing = true;

    private async Task SaveMessage()
    {
        await OnContactSaved.InvokeAsync(currentMessage);
        savedMessage = currentMessage;
        hasSavedMessage = !string.IsNullOrWhiteSpace(currentMessage);
        isEditing = false;
    }

    private void Cancel()
    {
        currentMessage = savedMessage;
        isEditing = false;
    }
}